{
  "info": {
    "name": "Session LAB",
    "description": "API collection for Session LAB: the PingFederate session story against in-process mocks. Sign in at the mock IdP (the cookie chains automatically in Postman/newman), authorize a redirect app, complete MFA, call an API, use the embedded widget, drop the session token and watch the Check-Session consequences, and inspect the flow reports. Every token is a labelled mock; the lab has no live mode.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "postman-session-lab"
  },
  "item": [
